<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+)
    This file controls which data can be extracted during device-to-device transfer
    and cloud backups. More granular control than backup_rules.xml
    Reference: https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the Room database in cloud backups -->
        <include domain="database" path="calculator_history_database" />
        
        <!-- Include shared preferences -->
        <include domain="sharedpref" path="." />
        
        <!-- Exclude cache and temporary files -->
        <exclude domain="cache" path="." />
    </cloud-backup>
    
    <device-transfer>
        <!-- Same rules for device-to-device transfer -->
        <include domain="database" path="calculator_history_database" />
        <include domain="sharedpref" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
